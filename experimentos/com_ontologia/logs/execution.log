```cpp
#include <AUnit.h>

#define TRIGGER_PIN 2
#define ECHO_PIN 3
#define TRIGGER_PULSE_US 10
#define ECHO_TIMEOUT_US 30000
#define SOUND_SPEED_CM_PER_US 0.0343

void initializeHardware() {
    pinMode(TRIGGER_PIN, OUTPUT);
    pinMode(ECHO_PIN, INPUT);
}

unsigned long measureDistance() {
    digitalWrite(TRIGGER_PIN, HIGH);
    delayMicroseconds(TRIGGER_PULSE_US);
    digitalWrite(TRIGGER_PIN, LOW);
    return pulseIn(ECHO_PIN, HIGH, ECHO_TIMEOUT_US);
}

float calculateDistance(unsigned long duration) {
    return (duration * SOUND_SPEED_CM_PER_US) / 2.0;
}

test(HCSR04_Test, MeasureDistance_ValidRange) {
    initializeHardware();
    unsigned long duration = measureDistance();
    float distance = calculateDistance(duration);
    
    assertTrue(distance >= 2.0);
    assertTrue(distance <= 400.0);
}

test(HCSR04_Test, MeasureDistance_ZeroEcho) {
    initializeHardware();
    digitalWrite(TRIGGER_PIN, LOW); // Simulate no echo
    unsigned long duration = measureDistance();
    
    assertEqual(duration, 0);
}

test(HCSR04_Test, MeasureDistance_Timeout) {
    initializeHardware();
    unsigned long duration = pulseIn(ECHO_PIN, HIGH, ECHO_TIMEOUT_US);
    
    assertEqual(duration, 0); // Expecting timeout to return 0
}

test(HCSR04_Test, MeasureDistance_Resolution) {
    initializeHardware();
    unsigned long duration = measureDistance();
    float distance = calculateDistance(duration);
    
    assertNear(distance, round(distance / 0.3) * 0.3, 0.1); // Check if distance is within resolution
}
