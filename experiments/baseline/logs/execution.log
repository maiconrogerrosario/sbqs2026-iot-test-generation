================================================================================
```cpp
#include <NewPing.h>

#define TRIGGER_PIN  9  // Pino do Trigger do sensor HC-SR04
#define ECHO_PIN     10 // Pino do Echo do sensor HC-SR04
#define MAX_DISTANCE 200 // Distância máxima em cm

NewPing sonar(TRIGGER_PIN, ECHO_PIN, MAX_DISTANCE);

void setup() {
  Serial.begin(9600);
}

void loop() {
  delay(50); // Aguarda um pouco entre as leituras
  unsigned int uS = sonar.ping(); // Envia o pulso e recebe o tempo de retorno
  float distance = uS / US_ROUNDTRIP_CM; // Converte o tempo em distância

  Serial.print("Distância: ");
  Serial.print(distance);
  Serial.println(" cm");

  // Casos de teste
  if (distance < 10) {
    Serial.println("Teste 1: Objeto muito próximo.");
  } else if (distance >= 10 && distance < 50) {
    Serial.println("Teste 2: Objeto a uma distância média.");
  } else if (distance >= 50 && distance < 100) {
    Serial.println("Teste 3: Objeto a uma distância longa.");
  } else {
    Serial.println("Teste 4: Objeto fora do alcance.");
  }
}
```
